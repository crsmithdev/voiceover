# No trailing slash: a symlink named node_modules is a file, not a
# directory, so `node_modules/` does not match one and it gets committed.
node_modules
.env
.worktrees/


# impeccable scratch: screenshots, decision rounds, reference boards
.impeccable/review/
.impeccable/mocks/
.impeccable/questions/
.impeccable/ref/
